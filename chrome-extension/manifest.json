{
    "manifest_version": 3,
    "name": "AI Interview Caption Bridge",
    "version": "1.0.0",
    "description": "Stream Google Meet captions to AI evaluation backend in real time.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://meet.google.com/*"
    ],
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://meet.google.com/*"
            ],
            "js": [
                "content/dom-observer.js",
                "content/meet-capture.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "AI Interview Bridge"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "utils/*.js"
            ],
            "matches": [
                "https://meet.google.com/*"
            ]
        }
    ]
}